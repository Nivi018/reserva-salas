{
  "name": "@reserva-salas/server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/app.test.ts src/private-app.test.ts",
    "test:integration": "node --env-file-if-exists=../.env.test --import tsx --test --test-concurrency=1 src/bookings.integration.test.ts src/accounts.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@hono/zod-validator": "0.7.6",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.22",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
